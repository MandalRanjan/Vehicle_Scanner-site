{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch index.html in Chrome",
      "type": "chrome",
      "request": "launch",
      "file": "${workspaceFolder}/index.html"
    },
    {
      "name": "Launch index.html in Edge",
      "type": "msedge",
      "request": "launch",
      "file": "${workspaceFolder}/index.html"
    },
    {
      "name": "Launch with Local Server (port 8000)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:8000/index.html",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "Start Local Web Server"
    }
  ]
}
