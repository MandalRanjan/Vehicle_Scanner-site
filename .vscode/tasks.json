{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Local Web Server",
      "type": "shell",
      "command": "python3 -m http.server 8000 || python -m http.server 8000 || py -m http.server 8000",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^Serving HTTP",
          "endsPattern": "^Serving HTTP"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Open Website in Default Browser",
      "type": "shell",
      "windows": {
        "command": "start \"\" index.html"
      },
      "osx": {
        "command": "open index.html"
      },
      "linux": {
        "command": "xdg-open index.html"
      },
      "problemMatcher": []
    }
  ]
}
